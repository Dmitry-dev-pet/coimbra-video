{
  "pipeline": [
    {
      "type": "readers.las",
      "filename": "INPUT.laz"
    },
    {
      "type": "filters.hag_nn",
      "count": 4,
      "max_distance": 25,
      "allow_extrapolation": false
    },
    {
      "type": "writers.gdal",
      "filename": "OUTPUT.tif",
      "dimension": "HeightAboveGround",
      "data_type": "float32",
      "gdaldriver": "GTiff",
      "output_type": "max",
      "resolution": 1,
      "nodata": -9999,
      "window_size": 0
    }
  ]
}
